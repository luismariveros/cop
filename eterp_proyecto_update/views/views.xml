<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_project_form_inherit_proveedores" model="ir.ui.view">
      <field name="name">project.project.form.inherit.proveedores</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="project.edit_project"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_id']" position="after">
          <field name="departamento_id"/>
        </xpath>

        <xpath expr="//field[@name='tag_ids']" position="after">
          <field name="monto_total"/>
          <field name="monto_obligado_proyecto"/>
        </xpath>

        <xpath expr="//field[@name='user_id']" position="before">
          <field name="fecha_project"/>
        </xpath>

        <xpath expr="//field[@name='partner_id']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>

        <notebook position="inside">
          <page string="Proveedores">
            <group>
              <group>
                <field name="monto_disponible" readonly="1"/>
              </group>
            </group>
            <field name="proveedor_ids" context="{'default_project_id': active_id}">
              <tree editable="bottom">
                <field name="partner_id"/>
                <field name="importe_total"/>
                <!-- <field name="importe_calculado" string="Importe en Productos" readonly="1"/>
                <field name="saldo_disponible" readonly="1"/> -->
                <button name="action_view_productos" type="object" icon="fa-search" 
                        string="Ver Productos"/>
              </tree>
              <form>
                <sheet>
                  <notebook>
                    <page string="Productos">
                      <field name="producto_ids">
                        <tree editable="bottom">
                          <field name="product_id"/>
                          <field name="importe"/>
                          <field name="objeto_gasto_id"/>
                          <field name="descripcion"/>
                        </tree>
                      </field>
                    </page>
                  </notebook>
                </sheet>
              </form>
            </field>
          </page>
          
          <!-- Nueva pestaña de Objetos de Gastos -->
          <page string="Objetos de Gastos">
            <field name="objeto_gasto_ids" context="{'default_project_id': active_id}">
              <tree editable="bottom">
                <field name="objeto_gasto_id"/>
                <field name="importe"/>
                <field name="descripcion"/>
              </tree>
            </field>
          </page>
          
          <page string="Jurídica">
                  <field name="juridica_ids" nolabel="1" context="{'default_project_id': id}">
                      <tree editable="bottom">
                          <field name="convenio_uep"/>
                          <field name="resolucion_snd"/>
                          <field name="fecha_resolucion"/>
                          
                          <field name="contrato_fecha"/>
                          <field name="adjunto_contrato" widget="binary"/>
                      </tree>
                  </field>
          </page>
          <page string="Pagos">
                  <field name="pagos_ids" nolabel="1" context="{'default_project_id': id}">
                      <tree editable="bottom">
                          <field name="project_id"/>
                          <field name="resolucion_snd"/>
                          <field name="str_resolucion_snd"/>
                          <field name="fecha_str"/>
                          <field name="fecha_vencimiento_str"/>
                          <field name="monto_obligado"/>
                      </tree>
                  </field>
          </page>

        </notebook>
      </field>
    </record>

    <record id="view_project_proveedores_product_tree" model="ir.ui.view">
      <field name="name">project.proveedores.product.tree</field>
      <field name="model">project.proveedor.producto</field>
      <field name="arch" type="xml">
        <tree editable="bottom">

          <field name="product_id"/>
          <field name="importe"/>
          <field name="objeto_gasto_id"/>
          <field name="descripcion"/>
        </tree>
      </field>
    </record>

    <!-- Nueva vista para filtros de Objetos de Gasto -->
    <record id="view_project_objeto_gasto_filter" model="ir.ui.view">
        <field name="name">project.objeto.gasto.filter</field>
        <field name="model">project.objeto.gasto</field>
        <field name="arch" type="xml">
            <search>
                <field name="objeto_gasto_id"/>
                <field name="nombre_gasto"/>
                <group expand="1" string="Agrupaciones">
                    <filter string="Por Objeto de Gasto" name="group_by_objeto_gasto" context="{'group_by': 'objeto_gasto_id'}"/>
                    <filter string="Por Proyecto" name="group_by_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_project_proveedores_product_filter" model="ir.ui.view">
        <field name="name">project.proveedores.product.filter</field>
        <field name="model">project.proveedor.producto</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="nombre_gasto"/>
                <!-- Agregar filtros para agrupar -->
                <group expand="1" string="Agrupaciones">
                    <filter string="Por Producto" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Por Objeto de Gasto" name="group_by_objeto_gasto" context="{'group_by': 'nombre_gasto'}"/>
                </group>
            </search>
        </field>
    </record>

  </data>
</odoo>