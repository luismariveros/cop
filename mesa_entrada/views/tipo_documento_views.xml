<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de árbol para Tipos de Documento -->
    <record id="view_eterp_tipo_documento_tree" model="ir.ui.view">
        <field name="name">eterp.tipo.documento.tree</field>
        <field name="model">eterp.tipo.documento</field>
        <field name="arch" type="xml">
            <tree string="Tipos de Documento" editable="bottom">
                <field name="nombre"/>
                <field name="codigo"/>
                <field name="descripcion"/>
                <field name="activo"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulario para Tipos de Documento -->
    <record id="view_eterp_tipo_documento_form" model="ir.ui.view">
        <field name="name">eterp.tipo.documento.form</field>
        <field name="model">eterp.tipo.documento</field>
        <field name="arch" type="xml">
            <form string="Tipo de Documento">
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="codigo"/>
                        </group>
                        <group>
                            <field name="activo"/>
                        </group>
                    </group>
                    <group>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana para Tipos de Documento -->
    <record id="action_eterp_tipo_documento" model="ir.actions.act_window">
        <field name="name">Tipos de Documento</field>
        <field name="res_model">eterp.tipo.documento</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo Tipo de Documento
            </p>
        </field>
    </record>
</odoo>