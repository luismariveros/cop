<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Modificar la vista tree de líneas de orden de compra para agregar objeto de gasto -->
        <record id="purchase_order_line_objeto_gasto_tree" model="ir.ui.view">
            <field name="name">purchase.order.line.objeto.gasto.tree</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Agregar campo de objeto de gasto antes de product_qty en la vista tree -->
                <xpath expr="//field[@name='order_line']/tree//field[@name='product_qty']" position="before">
                    <field name="objeto_gasto_id" options="{'no_create': True, 'no_open': True}" required="0"/>
                </xpath>
                
                <!-- Agregar también en la vista form para cuando se edita una línea -->
                <xpath expr="//field[@name='order_line']/form//field[@name='product_qty']" position="before">
                    <field name="objeto_gasto_id" options="{'no_create': True, 'no_open': True}" required="0"/>
                </xpath>
                
                <!-- Modificar el onchange del product_id para que no sobrescriba campos personalizados -->
                <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="attributes">
                    <attribute name="context">{'partner_id': parent.partner_id, 'quantity': product_qty, 'company_id': parent.company_id, 'preserve_objeto_gasto': True}</attribute>
                </xpath>
                
                <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                    <attribute name="context">{'partner_id': parent.partner_id, 'quantity': product_qty, 'company_id': parent.company_id, 'preserve_objeto_gasto': True}</attribute>
                </xpath>

                <!-- Agregar campo de objeto de gasto antes de product_qty en la vista tree -->
                <xpath expr="//field[@name='order_line']/tree//field[@name='price_subtotal']" position="after">
                    <field name="monto_usd" options="{'no_create': True, 'no_open': True}" required="0"/>
                </xpath>
                
                
            </field>
        </record>
    </data>
</odoo>