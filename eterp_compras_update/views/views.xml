<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Solución simplificada: solo cambiar el ordenamiento predeterminado de la vista tree -->
        <record id="purchase_order_tree_custom_order" model="ir.ui.view">
            <field name="name">purchase.order.tree.custom.order</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="default_order">fecha_orden desc</attribute>
                </xpath>

                <xpath expr="//field[@name='name']" position="after">
                    <field name="fecha_orden"/>
                </xpath>
            </field>
        </record>
        <record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Ocultar el campo currency_id original -->
                <xpath expr="//field[@name='currency_id']" position="after">
                <field name="currency_custom_id" options="{'no_create': True}" string="Moneda"/>
                </xpath>
                <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="invisible">1</attribute>
                </xpath>
                

            </field>
        </record>
    </data>
</odoo>