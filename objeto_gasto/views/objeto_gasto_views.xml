<odoo>
    <record id="view_objeto_gasto_tree" model="ir.ui.view">
        <field name="name">objeto.gasto.tree</field>
        <field name="model">objeto.gasto</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="year"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_objeto_gasto_form" model="ir.ui.view">
        <field name="name">objeto.gasto.form</field>
        <field name="model">objeto.gasto</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="year"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Detalles">
                            <field name="detalle_ids">
                                <list editable="bottom">
                                    <field name="codigo"/>
                                    <field name="name"/>
                                    <field name="descripcion"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_objeto_gasto" model="ir.actions.act_window">
        <field name="name">Objetos de Gasto</field>
        <field name="res_model">objeto.gasto</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_objeto_gasto" name="Clasificador Objeto de Gasto" sequence="10" action="action_objeto_gasto"
    web_icon="objeto_gasto,static/description/objeto_gasto.png"/>
</odoo>
