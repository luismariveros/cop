<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulario de Logos -->
    <record id="view_gestion_operacional_logo_form" model="ir.ui.view">
        <field name="name">gestion.operacional.logo.form</field>
        <field name="model">gestion.operacional.logo</field>
        <field name="arch" type="xml">
            <form string="Gestión de Logos para Reportes">
                <sheet>
                    <group string="Logos para Reportes">
                        <field name="name"/>
                        <field name="logo_1"
                               widget="image"
                               class="oe_avatar"
                               options="{'size': [128, 128]}"/>
                        <field name="logo_2"
                               widget="image"
                               class="oe_avatar"
                               options="{'size': [128, 128]}"/>
                        <field name="logo_3"
                               widget="image"
                               class="oe_avatar"
                               options="{'size': [128, 128]}"/>
                        <field name="logo_4"
                               widget="image"
                               class="oe_avatar"
                               options="{'size': [128, 128]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Lista de Logos -->
    <record id="view_gestion_operacional_logo_tree" model="ir.ui.view">
        <field name="name">gestion.operacional.logo.list</field>
        <field name="model">gestion.operacional.logo</field>
        <field name="arch" type="xml">
            <list string="Logos para Reportes">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_logos_gestion_operacional" model="ir.actions.act_window">
        <field name="name">Logos para Reportes</field>
        <field name="res_model">gestion.operacional.logo</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_logos_gestion_operacional"
              name="Logos para Reporte"
              parent="menu_gestion_operacional"
              action="action_logos_gestion_operacional"
              sequence="10"/>

</odoo>