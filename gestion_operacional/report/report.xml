<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="reporte_gestion_operacional" model="report.paperformat">
        <field name="name">Ficha de Verificación</field>
        <field name="format">Legal</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- Acción del Reporte -->
    <record id="gestion_operacional_report" model="ir.actions.report">
        <field name="name">Reporte de Gestión Operacional</field>
        <field name="model">gestion.operacional</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_operacional.report_gestion_operacional</field>
        <field name="report_file">gestion_operacional.report_gestion_operacional</field>
        <field name="binding_model_id" ref="model_gestion_operacional"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="reporte_gestion_operacional"/>
        <field name="print_report_name">'GestionOperacional_%s' % (object.expediente or '')</field>
    </record>

    <!-- Plantilla del Reporte -->
    <template id="report_gestion_operacional">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                <t t-foreach="doc.lineas_detalle_ids" t-as="detalle">
                    <div class="page" style="page-break-after: always; font-family: Arial, sans-serif;">
                        <!-- Report Headers -->
                        <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;">
                            <tr>
                                <!-- Acceso a imágenes desde la carpeta static del módulo -->
                                <td style="width: 30%;"><img t-att-src="'/gestion_operacional/static/img/snd.png'" alt="SND Logo" style="max-width: 250px;"/></td>
                                <td style="width: 30%;"><img t-att-src="'/gestion_operacional/static/img/cop.png'" alt="COP Logo" style="max-width: 150px;"/></td>
                                <td style="width: 30%;"></td>
                                <td style="width: 30%;"><img t-att-src="'/gestion_operacional/static/img/asu.png'" alt="ASU Logo" style="max-width: 150px;"/></td>
                                <td style="width: 30%;"><img t-att-src="'/gestion_operacional/static/img/panam.png'" alt="Panamerican Logo" style="max-width: 150px;"/></td>
                            </tr>
                            <tr>
                                <td colspan="5" style="border-bottom: 1px solid #000; padding: 10px 0; text-align: center;">DIRECCIÓN DE ADMINISTRACIÓN Y FINANZAS - ASU 2024/2025</td>
                            </tr>
                            <tr>
                                <td colspan="5" style="border-bottom: 1px solid #000; padding: 10px 0; text-align: center;">UNIDAD DE GESTION OPERACIONAL</td>
                            </tr>
                            <tr>
                                <td colspan="5" style="border-bottom: 1px solid #000; padding: 10px 0; text-align: center;">FORMULARIO DE VERIFICACIÓN DE LEGAJOS PROVEEDORES N°: <t t-esc="doc.nro_formulario or ''"/></td>
                            </tr>

                        </table>

                    
                        <!-- General Information Table -->
                        <table class="table table-no-border" style="width: 100%; margin-top: 10px; margin-bottom: 10px; font-size: 12px;">
                            <tr>
                                <td style="width: 10%; padding: 5px; border: 1px solid #dee2e6;"><strong>Expediente N°:</strong></td>
                                <td style="width: 50%; padding: 5px; border: 1px solid #dee2e6;"><t t-esc="doc.expediente or ''"/></td>
                                <td style="width: 10%; padding: 5px; border: 1px solid #dee2e6;"><strong>Fecha y Hora de Recepción:</strong></td>
                                <td style="width: 50%; padding: 5px; border: 1px solid #dee2e6; text-align: right;"><t t-esc="doc.fecha_recepcion_expediente_gmt3 or ''"/></td>         
                            </tr>

                            <tr>
                                <td style="width: 10%; padding: 5px; border: 1px solid #dee2e6;"><strong>Proyecto:</strong></td>
                                <td style="width: 50%; padding: 5px; border: 1px solid #dee2e6;"><t t-esc="doc.proyecto_id.name or ''"/></td>
                                <td style="padding: 5px; border: 1px solid #dee2e6;"><strong>Solicitante:</strong></td>
                                <td style="padding: 5px; border: 1px solid #dee2e6; text-align: right;"><t t-esc="doc.area_solicitante.name or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 5px; border: 1px solid #dee2e6;"><strong>Proveedor:</strong></td>
                                <td style="padding: 5px; border: 1px solid #dee2e6;"><t t-esc="doc.proveedor_name or ''"/></td>
                                <td style="padding: 5px; border: 1px solid #dee2e6;"><strong>Ruc:</strong></td>
                                <td style="padding: 5px; border: 1px solid #dee2e6; text-align: right;"><t t-esc="doc.ruc_proveedor or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 5px; border: 1px solid #dee2e6;"><strong>Fecha Revisión:</strong></td>
                                <td style="padding: 5px; border: 1px solid #dee2e6;"><t t-esc="doc.fecha.strftime('%d/%m/%Y') if doc.fecha else ''"/></td>
                                <td style="padding: 5px; border: 1px solid #dee2e6;"><strong>Monto Total del Proyecto:</strong></td>
                                <td style="padding: 5px; border: 1px solid #dee2e6; text-align: right;"><t t-esc="'{:,.0f}'.format(doc.monto_total_proyecto or 0).replace(',', '.')"/> Gs</td>
                                
                            </tr>
                            <tr>
                                <td style="padding: 5px; border: 1px solid #dee2e6;"><strong>Revisión N°</strong></td>
                                <td style="padding: 5px; border: 1px solid #dee2e6;"><t t-esc="detalle_index + 1"/></td>
                                <td style="width: 15%; padding: 5px; border: 1px solid #dee2e6;"><strong>Monto Solicitado:</strong></td>
                                <td style="width: 25%; padding: 5px; border: 1px solid #dee2e6; text-align: right;"><t t-esc="'{:,.0f}'.format(doc.monto or 0).replace(',', '.')"/> Gs</td>
                                
                            </tr>
                        </table>
                    
                        <!-- Campos de Cumplimiento -->
                        <t t-set="fields_list" t-value="[
                            ('remision_expediente', 'Remisión del Expediente'),
                            ('nota_solicitud_pago', 'Nota de Solicitud de Pago'),
                            ('invoice', 'Factura y/o Invoice'),
                            ('nota_remision', 'Nota de Remisión'),
                            ('cct', 'CCT'),
                            ('pago_ultima_djj', 'Pago de la Última DJJ'),
                            ('constancia_ruc', 'Constancia de RUC'),
                            ('certificado_social', 'Certificado de Seguridad Social'),
                            ('formulario_fis', 'Formulario FIS'),
                            ('formulario_fip', 'Formulario FIP'),
                            ('contancia_registro_prestadores_servicios', 'Constancia de Registro de Prestadores de Servicios'),
                            ('nota_prestacion_servicio', 'Nota de Prestación de Servicio'),
                            ('nota_pedido_realizacion_trabajo', 'Nota de Pedido de Realización de Trabajo'),
                            ('orden_de_compra', 'Orden de Compra y/o Servicio'),
                            ('informe_mensual_actividades_contratado', 'Informe Mensual de Actividades Contratado'),
                            ('resolucion_nombremiento_encargado', 'Resolución de Nombramiento del Encargado de la UOC'),
                            ('nota_pedido_interno', 'Nota de Pedido Interno para inicio del llamado'),
                            ('informe_dictamen_adquisicion', 'Informe y Dictamen que fundamente la Adquisición'),
                            ('res_aprovacion_programa_anual_contrataciones', 'Resolución de Aprobación del PAC'),
                            ('nota_remision_pac_pfi_dncp', 'Nota de Remisión del PAC a la DNCP'),
                            ('certificado_disponibilidad_presupuestaria', 'Certificado de Disponibilidad Presupuestaria'),
                            ('carta_invitacion_proveedores', 'Carta de Invitación a Proveedores'),
                            ('acta_apertura_sobres', 'Acta de Apertura de Sobres'),
                            ('informe_comite_evaluacion', 'Informe del Comité de Evaluación'),
                            ('informe_dictamen_contratacion', 'Informe o Dictamen sobre Contratación'),
                            ('res_adjudicacion', 'Resolución de Adjudicación'),
                            ('copia_contrato', 'Copia del Contrato'),
                            ('codigo_contrataciones', 'Código de Contrataciones'),
                            ('poliza_seguro_djj', 'Póliza de Seguro y DJJ'),
                            ('djj_garantia_anticipo', 'DJJ Garantía de Anticipo'),
                            ('djj_respoponsabilidad_profesional', 'DJJ Responsabilidad Profesional'),
                            ('djj_garantia_mantenimiento_oferta', 'DJJ Garantía Mantenimiento Oferta'),
                            ('cert_interdiccion_judicial_quiebra', 'Certificado Interdicción Judicial'),
                            ('informe_anotaciones_personales', 'Informe de Anotaciones Personales'),
                            
                            
                        ]" />

                            <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                <tbody>
                                    <tr>
                                        <td style="width: 50%; padding: 0;">
                                            <table style="width: 100%; border: 1px solid #dee2e6; border-collapse: collapse;">
                                                <thead>
                                                    <tr style="background-color: #f0f0f0; text-align: center; height: 40px;">
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">Item</th>
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">Documento</th>
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">Cumple</th>
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">No Cumple</th>
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">No Aplica</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="fields_list[:17]" t-as="field">
                                                        <tr style="height: 40px !important; min-height: 40px; vertical-align: middle;">
                                                            <td style="border: 1px solid #dee2e6; text-align: center; padding: 3px; vertical-align: middle;"><t t-esc="field_index + 1"/></td>
                                                            <td style="border: 1px solid #dee2e6; padding: 3px; vertical-align: middle;"><t t-esc="field[1]"/></td>
                                                            <td style="border: 1px solid #dee2e6; text-align: center; padding: 3px; vertical-align: middle;">
                                                                <t t-if="detalle[field[0]] == 'cumple'">X</t>
                                                            </td>
                                                            <td style="border: 1px solid #dee2e6; text-align: center; padding: 3px; vertical-align: middle;">
                                                                <t t-if="detalle[field[0]] == 'no_cumple'">X</t>
                                                            </td>
                                                            <td style="border: 1px solid #dee2e6; text-align: center; padding: 3px; vertical-align: middle;">
                                                                <t t-if="detalle[field[0]] == 'no_aplica'">X</t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </td>
                                        <td style="width: 50%; padding: 0;">
                                            <table style="width: 100%; border: 1px solid #dee2e6; border-collapse: collapse;">
                                                <thead>
                                                    <tr style="background-color: #f0f0f0; text-align: center; height: 40px; vertical-align: middle;">
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">Item</th>
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">Documento</th>
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">Cumple</th>
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">No Cumple</th>
                                                        <th style="border: 1px solid #dee2e6; padding: 5px; vertical-align: middle;">No Aplica</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="fields_list[17:]" t-as="field">
                                                        <tr style="height: 40px !important; min-height: 40px;">
                                                            <td style="border: 1px solid #dee2e6; text-align: center; padding: 3px; vertical-align: middle;"><t t-esc="field_index + 18"/></td>
                                                            <td style="border: 1px solid #dee2e6; padding: 3px; vertical-align: middle;"><t t-esc="field[1]"/></td>
                                                            <td style="border: 1px solid #dee2e6; text-align: center; padding: 3px; vertical-align: middle;">
                                                                <t t-if="detalle[field[0]] == 'cumple'">X</t>
                                                            </td>
                                                            <td style="border: 1px solid #dee2e6; text-align: center; padding: 3px; vertical-align: middle;">
                                                                <t t-if="detalle[field[0]] == 'no_cumple'">X</t>
                                                            </td>
                                                            <td style="border: 1px solid #dee2e6; text-align: center; padding: 3px; vertical-align: middle;">

                                                                <t t-if="detalle[field[0]] == 'no_aplica'">X</t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div style="page-break-after: always;"></div>
                        <br/>
                        <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif;">
                            <tr>
                                <!-- Acceso a imágenes desde la carpeta static del módulo -->
                                <td style="width: 30%;"><img t-att-src="'/gestion_operacional/static/img/snd.png'" alt="SND Logo" style="max-width: 250px;"/></td>
                                <td style="width: 30%;"><img t-att-src="'/gestion_operacional/static/img/cop.png'" alt="COP Logo" style="max-width: 150px;"/></td>
                                <td style="width: 30%;"></td>
                                <td style="width: 30%;"><img t-att-src="'/gestion_operacional/static/img/asu.png'" alt="ASU Logo" style="max-width: 150px;"/></td>
                                <td style="width: 30%;"><img t-att-src="'/gestion_operacional/static/img/panam.png'" alt="Panamerican Logo" style="max-width: 150px;"/></td>
                            </tr>
                            <tr>
                                <td colspan="5" style="border-bottom: 1px solid #000; padding: 10px 0; text-align: center;">DIRECCIÓN DE ADMINISTRACIÓN Y FINANZAS - ASU 2024/2025</td>
                            </tr>
                            <tr>
                                <td colspan="5" style="border-bottom: 1px solid #000; padding: 10px 0; text-align: center;">UNIDAD DE GESTION OPERACIONAL</td>
                            </tr>
                            <tr>
                                <td colspan="5" style="border-bottom: 1px solid #000; padding: 10px 0; text-align: center;">FORMULARIO DE VERIFICACIÓN DE LEGAJOS PROVEEDORES</td>
                            </tr>

                        </table>

                        <!-- Detalle de Documentos -->
                        <div style="margin-top: 20px;">
                            <h4 style="background-color: #f0f0f0; padding: 5px; border: 1px solid #dee2e6;">DETALLE DE DOCUMENTOS</h4>
                            <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                <tbody>
                                    <tr t-foreach="doc.documento_ids" t-as="documento">
                                        <td style="border: 1px solid #dee2e6; padding: 5px;">
                                            <t t-esc="documento_index + 1"/>. <t t-esc="documento.name or ''"/>
                                            <t t-if="documento.fecha"> de fecha <t t-esc="documento.fecha.strftime('%d/%m/%Y')"/></t>
                                        </td>
                                    </tr>
                                    <!-- Si no hay documentos, mostrar algunos campos vacíos -->
                                    <t t-if="not doc.documento_ids">
                                        <tr><td style="border: 1px solid #dee2e6; padding: 5px;">1. </td></tr>
                                        <tr><td style="border: 1px solid #dee2e6; padding: 5px;">2. </td></tr>
                                        <tr><td style="border: 1px solid #dee2e6; padding: 5px;">3. </td></tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Resumen de Desembolso/Pagos -->
                        <div style="margin-top: 20px;">
                            <h4 style="background-color: #f0f0f0; padding: 5px; border: 1px solid #dee2e6;">RESUMEN DE DESEMBOLSO / PAGOS</h4>
                            <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                <tbody>
                                    <tr>
                                        <td style="width: 40%; border: 1px solid #dee2e6; padding: 5px;">MONTO APROBADO DEL PROYECTO:</td>
                                        <td style="width: 60%; border: 1px solid #dee2e6; padding: 5px; text-align: right;">
                                            <t t-esc="'{:,.0f}'.format(doc.monto_total_proyecto or 0).replace(',', '.')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 5px;">MONTO DESEMBOLSADO:</td>
                                        <td style="border: 1px solid #dee2e6; padding: 5px; text-align: right;">
                                            <t t-esc="'{:,.0f}'.format(doc.monto or 0).replace(',', '.')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 5px;">SALDO PENDIENTE DE OBLIGACIÓN:</td>
                                        <td style="border: 1px solid #dee2e6; padding: 5px; text-align: right;">
                                            <t t-esc="'{:,.0f}'.format((doc.saldo_disponible or 0) - (doc.monto or 0)).replace(',', '.')"/>
                                        </td>
                                        
                                    </tr>
                                </tbody>
                            </table>
                            
                            <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 10px;">
                                <tbody>
                                    <tr>
                                        <td style="width: 40%; border: 1px solid #dee2e6; padding: 5px;">TOTAL PAGADOS A LA FECHA:</td>
                                        <td style="width: 60%; border: 1px solid #dee2e6; padding: 5px; text-align: right;">
                                            <t t-esc="'{:,.0f}'.format((doc.monto_utilizado or 0) + (doc.monto or 0)).replace(',', '.')"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <!-- Detalle de Pagos -->
                            <h5 style="background-color: #f0f0f0; padding: 5px; border: 1px solid #dee2e6; margin-top: 10px;">DETALLE DE PAGOS</h5>
                            <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                <thead>
                                    <tr>
                                        <th style="width: 30%; border: 1px solid #dee2e6; padding: 5px; background-color: #f8f8f8;">N° FORMULARIO</th>
                                        <th style="width: 30%; border: 1px solid #dee2e6; padding: 5px; background-color: #f8f8f8;">FECHA</th>
                                        <th style="width: 40%; border: 1px solid #dee2e6; padding: 5px; text-align: right; background-color: #f8f8f8;">MONTO</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Buscar registros confirmados del mismo proyecto -->
                                    <t t-set="registros_proyecto" t-value="env['gestion.operacional'].search([('proyecto_id', '=', doc.proyecto_id.id), ('state', '=', 'confirmado')])"/>
                                    <t t-foreach="registros_proyecto" t-as="registro">
                                        <tr>
                                            <td style="border: 1px solid #dee2e6; padding: 5px;"><t t-esc="registro.nro_formulario or ''"/></td>
                                            <td style="border: 1px solid #dee2e6; padding: 5px;"><t t-esc="registro.fecha.strftime('%d/%m/%Y') if registro.fecha else ''"/></td>
                                            <td style="border: 1px solid #dee2e6; padding: 5px; text-align: right;">
                                                <t t-esc="'{:,.0f}'.format(registro.monto or 0).replace(',', '.')"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Mostrar el registro actual si está en estado borrador -->
                                    <t t-if="doc.state == 'borrador'">
                                        <tr style="background-color: #e6f7ff;">
                                            <td style="border: 1px solid #dee2e6; padding: 5px;"><t t-esc="doc.nro_formulario or ''"/> (actual)</td>
                                            <td style="border: 1px solid #dee2e6; padding: 5px;"><t t-esc="doc.fecha.strftime('%d/%m/%Y') if doc.fecha else ''"/></td>
                                            <td style="border: 1px solid #dee2e6; padding: 5px; text-align: right;">
                                                <t t-esc="'{:,.0f}'.format(doc.monto or 0).replace(',', '.')"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Si no hay registros, mostrar el actual -->
                                    <t t-if="not registros_proyecto and doc.state != 'borrador'">
                                        <tr>
                                            <td style="border: 1px solid #dee2e6; padding: 5px;"><t t-esc="doc.nro_formulario or ''"/></td>
                                            <td style="border: 1px solid #dee2e6; padding: 5px;"><t t-esc="doc.fecha.strftime('%d/%m/%Y') if doc.fecha else ''"/></td>
                                            <td style="border: 1px solid #dee2e6; padding: 5px; text-align: right;">
                                                <t t-esc="'{:,.0f}'.format(doc.monto or 0).replace(',', '.')"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2" style="border: 1px solid #dee2e6; padding: 5px; text-align: right; font-weight: bold;">TOTAL:</td>
                                        <td style="border: 1px solid #dee2e6; padding: 5px; text-align: right; font-weight: bold;">
                                            <t t-esc="'{:,.0f}'.format((doc.monto_utilizado or 0) + (doc.monto or 0)).replace(',', '.')"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Saldo Financiero -->
                        <div style="margin-top: 20px;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                <tbody>
                                    <tr>
                                        <td style="width: 40%; border: 1px solid #dee2e6; padding: 5px; font-weight: bold;">SALDO FINANCIERO</td>
                                        <td style="width: 60%; border: 1px solid #dee2e6; padding: 5px; text-align: right; background-color: #ffffcc;">
                            
                                            <t t-esc="'{:,.0f}'.format((doc.saldo_disponible or 0) - (doc.monto or 0)).replace(',', '.')"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Control de Pagos Imputados al Proyecto -->
                        <div style="margin-top: 20px;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 5px; text-align: center; background-color: #f0f0f0;">
                                            CONTROL DE PAGOS IMPUTADOS AL PROYECTO "<t t-raw="doc.proyecto_id.name or ''"/>"
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 10px;">
                                <thead>
                                    <tr>
                                        <th style="width: 20%; border: 1px solid #dee2e6; padding: 5px;">FECHA</th>
                                        <th style="width: 40%; border: 1px solid #dee2e6; padding: 5px;">PROVEEDOR</th>
                                        <th style="width: 20%; border: 1px solid #dee2e6; padding: 5px;">FACTURA Nº</th>
                                        <th style="width: 20%; border: 1px solid #dee2e6; padding: 5px; text-align: right;">MONTO</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.invoice_ids" t-as="factura">
                                        <td style="border: 1px solid #dee2e6; padding: 5px;">
                                            <t t-esc="factura.invoice_date.strftime('%d/%m/%Y') if factura.invoice_date else ''"/>
                                        </td>
                                        <td style="border: 1px solid #dee2e6; padding: 5px;">
                                            <t t-esc="doc.proveedor_name or ''"/>
                                        </td>
                                        <td style="border: 1px solid #dee2e6; padding: 5px;">
                                            <t t-esc="factura.name or ''"/>
                                        </td>
                                        <td style="border: 1px solid #dee2e6; padding: 5px; text-align: right;">
                                            <t t-esc="'{:,.0f}'.format(factura.amount_total or 0).replace(',', '.')"/>
                                        </td>
                                    </tr>
                                    <!-- Si no hay facturas, mostrar una fila con los datos del proveedor -->
                                    <t t-if="not doc.invoice_ids">
                                        <tr>
                                            <td style="border: 1px solid #dee2e6; padding: 5px;">
                                                <t t-esc="doc.fecha.strftime('%d/%m/%Y') if doc.fecha else ''"/>
                                            </td>
                                            <td style="border: 1px solid #dee2e6; padding: 5px;">
                                                <t t-esc="doc.proveedor_name or ''"/>
                                            </td>
                                            <td style="border: 1px solid #dee2e6; padding: 5px;"></td>
                                            <td style="border: 1px solid #dee2e6; padding: 5px; text-align: right;">
                                                <t t-esc="'{:,.0f}'.format(doc.monto or 0).replace(',', '.')"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" style="border: 1px solid #dee2e6; padding: 5px; text-align: right; font-weight: bold;">TOTAL:</td>
                                        <td style="border: 1px solid #dee2e6; padding: 5px; text-align: right; font-weight: bold;">
                                            <t t-esc="'{:,.0f}'.format(doc.monto or 0).replace(',', '.')"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        
                        <!-- Observaciones -->
                        <div style="margin-top: 20px;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 5px; font-weight: bold;">OBSERVACIONES:</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 5px; min-height: 40px;">
                                            <t t-esc="doc.lineas_detalle_ids[0].observaciones or ''"/>
                                            
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Destino -->
                        <div style="margin-top: 20px;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 5px; font-weight: bold;">DESTINO:</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #dee2e6; padding: 5px;">
                                            <table style="width: 100%;">
                                                <tr>
                                                    <td style="width: 5%; text-align: center; border: 1px solid #dee2e6;">X</td>
                                                    <td style="width: 95%; padding-left: 10px;"><t t-esc="doc.destino or ''"/></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>


                        <div style="margin-top: 30px; display: flex; justify-content: space-between;">
                            <div style="width: 33%; text-align: center;">
                                <p>Elaborado por:</p>
                                <br/>
                                <br/>
                                <div style="border-top: 1px solid black; width: 80%; margin: 0 auto; padding-top: 5px;">Nombre y Firma</div>
                            </div>
                            <div style="width: 33%; text-align: center;">
                                <p>Coordinación Financiera:</p>
                                <br/>
                                <br/>
                                <div style="border-top: 1px solid black; width: 80%; margin: 0 auto; padding-top: 5px;">Nombre y Firma</div>
                            </div>
                            <div style="width: 33%; text-align: center;">
                                <p>Verificado por:</p>
                                <br/>
                                <br/>
                                <div style="border-top: 1px solid black; width: 80%; margin: 0 auto; padding-top: 5px;">Nombre y Firma</div>
                            </div>
                        </div>
                    </div>    
                </t>
                </t>
            </t>
        </t>
    </template>
</odoo>