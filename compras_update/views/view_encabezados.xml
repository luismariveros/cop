<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de formulario para encabezados -->
        <record id="view_report_encabezado_form" model="ir.ui.view">
            <field name="name">report.encabezado.form</field>
            <field name="model">report.encabezado</field>
            <field name="arch" type="xml">
                <form string="Encabezado para Reportes">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="predeterminado"/>
                            <field name="departamento"/>
                        </group>
                        <group string="Imágenes de Encabezado">
                            <field name="imagen_izquierda" widget="image" class="oe_avatar"/>
                            <field name="imagen_centro_izquierda" widget="image" class="oe_avatar"/>
                            <field name="imagen_centro_derecha" widget="image" class="oe_avatar"/>
                            <field name="imagen_derecha" widget="image" class="oe_avatar"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de árbol para encabezados -->
        <record id="view_report_encabezado_tree" model="ir.ui.view">
            <field name="name">report.encabezado.tree</field>
            <field name="model">report.encabezado</field>
            <field name="arch" type="xml">
                <tree string="Encabezados para Reportes">
                    <field name="name"/>
                    <field name="active"/>
                    <field name="predeterminado"/>
                    <field name="departamento"/>
                </tree>
            </field>
        </record>

        <!-- Acción para encabezados -->
        <record id="action_report_encabezado" model="ir.actions.act_window">
            <field name="name">Encabezados para Reportes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">report.encabezado</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Elemento de menú para encabezados -->
        <menuitem id="menu_report_encabezado"
                  name="Encabezados de Reporte"
                  action="action_report_encabezado"
                  parent="purchase.menu_purchase_config"
                  sequence="20"/>
    </data>
</odoo>