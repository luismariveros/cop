<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Actualizar la acción del reporte oficial -->
        <record id="orden_compras_report" model="ir.actions.report">
            <!-- Eliminamos la restricción de grupo para que todos puedan ver el reporte -->
            <field name="groups_id" eval="[(5, 0, 0)]"/>
            <field name="binding_model_id" ref="purchase.model_purchase_order"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Orden de Compra/Servicio (OFICIAL) - ' + object.name</field>
        </record>
        
        <!-- Actualizar la plantilla del reporte oficial para verificar la autorización -->
        <template id="report_purchase_order_authorized" inherit_id="compras_update.report_purchase_order" primary="True">
            <xpath expr="//t[@t-call='web.html_container']" position="before">
                <t t-if="not docs or not docs[0].daf_authorized">
                    <t t-set="docs" t-value="docs.filtered(lambda d: d.daf_authorized)"/>
                    <t t-if="not docs">
                        <div class="alert alert-danger text-center">
                            <h3>Acceso Denegado</h3>
                            <p>Este documento no ha sido autorizado por la Dirección de Administración y Finanzas.</p>
                            <p>Por favor, solicite la autorización antes de imprimir el documento oficial.</p>
                        </div>
                    </t>
                </t>
            </xpath>
            
            <!-- Añadir indicador de autorización en el reporte -->
            <xpath expr="//div[@class='text-center mb-4']" position="after">
                <div class="text-right mb-2" style="font-size: 10px !important; color: green;">
                    <strong>DOCUMENTO OFICIAL AUTORIZADO</strong>
                </div>
            </xpath>
        </template>

</odoo>