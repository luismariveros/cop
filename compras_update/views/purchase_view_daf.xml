<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Actualizar la vista de orden de compra para añadir campos y botones de autorización DAF -->
        <record model="ir.ui.view" id="purchase_order_daf_form_view">
            <field name="name">purchase.order.daf.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Añadir botón para autorización DAF en header -->
                <xpath expr="//header" position="inside">
                    <!-- Añadir botón para solicitar autorización -->
                    <button name="action_request_daf_authorization" 
                            string="SOLICITAR AUTORIZACIÓN" 
                            type="object"
                            invisible="daf_authorized or state not in ['purchase'] or authorization_requested"/>
                    
                    <button name="action_authorize_daf" 
                            string="AUTORIZAR" 
                            type="object" 
                            class="oe_highlight"
                            groups="compras_update.group_daf"
                            invisible="daf_authorized or state not in ['purchase']"
                            />
                </xpath>
                
                <!-- Añadir botón para revocar autorización -->
                <xpath expr="//button[@name='button_confirm']" position="after">
                    <button name="action_revoke_daf_authorization" 
                            string="Revocar Autorización" 
                            type="object" 
                            groups="base.group_system"
                            invisible="not daf_authorized"/>
                </xpath>
                
                <!-- Añadir información de autorización DAF en la pestaña "Otra información" -->
                <xpath expr="//page[@name='purchase_delivery_invoice']" position="after">
                    <page string="Autorización DAF">
                        <group>
                            <group>
                                <field name="daf_authorized" readonly="1"/>
                                <field name="daf_authorized_by" readonly="1"  invisible="not daf_authorized"/>
                                <field name="daf_authorized_date" readonly="1"  invisible="not daf_authorized"/>
                                <field name="authorization_requested" readonly="1"/>
                                <field name="authorization_requested_by" readonly="1"  invisible="not authorization_requested"/>
                                <field name="authorization_requested_date" readonly="1" invisible="not authorization_requested"/>
                            </group>
                        </group>
                    </page>
                </xpath>
                
                <!-- Añadir indicador visual de autorización en la cabecera -->
                <xpath expr="//div[hasclass('oe_title')]" position="after">
                    <!-- Indicador de autorización -->
                    <div class="alert alert-success" invisible="not daf_authorized" role="alert">
                        <span class="fa fa-check-circle"/> Autorizado por <field name="daf_authorized_by" readonly="1" nolabel="1"/> el <field name="daf_authorized_date" readonly="1" widget="datetime" nolabel="1"/>
                    </div>
                    
                    <!-- Indicador de solicitud pendiente -->
                    <div class="alert alert-warning" invisible="not authorization_requested or daf_authorized" role="alert">
                        <span class="fa fa-clock-o"/> Autorización solicitada por <field name="authorization_requested_by" readonly="1" nolabel="1"/> el <field name="authorization_requested_date" readonly="1" widget="datetime" nolabel="1"/>
                    </div>
                </xpath>
            </field>
        </record>

</odoo>