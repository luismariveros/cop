<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Rediseño completo de la vista formulario de orden de compra -->
        <record model="ir.ui.view" id="purchase_order_form_redesign">
            <field name="name">purchase.order.form.redesign</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Cambiar etiqueta del botón "Crear factura" a "Cargar factura" -->
                <xpath expr="//button[@name='action_create_invoice']" position="attributes">
                    <attribute name="string">Cargar Factura</attribute>
                </xpath>

                <xpath expr="//button[@name='confirm_reminder_mail']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//button[@name='action_rfq_send']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//button[@name='print_quotation']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                
                <!-- Ocultar botón de confirmación para usuarios no autorizados (D.A.F.) -->
                <xpath expr="//button[@name='button_confirm']" position="attributes">
                    <attribute name="groups">purchase.group_purchase_manager</attribute>
                    <attribute name="string">Confirmar Orden</attribute>
                </xpath>

                
                <!-- Reemplazar completamente la sección de grupos en la cabecera -->
                <xpath expr="//sheet/group" position="replace">
                    <div class="row">
                        <!-- Primera columna - campos originales del lado izquierdo -->
                        <div class="col-md-6">
                            <group>
                                <field name="date_planned" invisible="1"/>
                                <field name="mail_reminder_confirmed" invisible="1"/>
                                <field name="sin_secuencia" string="Omitir Secuencia"/>
                                <field name="proyect_id"/>
                                <field name="nombre_objeto_gasto" invisible="1"/>
                                <field name="partner_id" widget="res_partner_many2one" context="{'res_partner_search_mode': 'supplier', 'show_vat': True}" placeholder="Name, TIN, Email, or Reference"/>
                                <!-- Ocultamos este campo ya que aparece en la tarjeta de proveedor -->
                                <field name="importe_proveedor_proyecto" invisible="1"/>
                                <field name="currency_id" groups="base.group_multi_currency" force_save="1"/>
                                <field name="id" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                                <field name="currency_id" invisible="1" groups="!base.group_multi_currency"/>
                            </group>
                                                        <!-- Nueva tarjeta de información del proyecto -->
                            <div class="alert" style="background-color: #fff3cd; border: 1px solid #ffeeba; border-radius: 4px; padding: 8px; margin-top: 10px; margin-bottom: 10px; width: 100%;" attrs="{'invisible': [('proyect_id', '=', False)]}">
                                <div style="display: flex; align-items: center; margin-bottom: 5px;">
                                    <i class="fa fa-folder-open" style="color: #856404; margin-right: 5px;"></i>
                                    <span style="color: #856404; font-weight: bold;">Información del Proyecto</span>
                                </div>
                                <hr style="margin-top: 5px; margin-bottom: 8px; border-color: #ffeeba;"/>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div style="font-size: 12px; color: #666;">Importe Total:</div>
                                        <field name="proyecto_monto_total" widget="monetary" nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <div style="font-size: 12px; color: #666;">Importe Obligado:</div>
                                        <field name="proyecto_monto_obligado" widget="monetary" nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <div style="font-size: 12px; color: #666;">Saldo Obligado:</div>
                                        <field name="saldo_monto_obligado" widget="monetary" nolabel="1" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                        <!-- Tarjeta de información del proveedor -->
                            <div class="alert" style="background-color: #edf8ed; border: 1px solid #b8e0b8; border-radius: 4px; padding: 8px; margin-top: 10px; margin-bottom: 10px; width: 100%;" attrs="{'invisible': [('partner_id', '=', False)]}">
                                <div style="display: flex; align-items: center; margin-bottom: 5px;">
                                    <i class="fa fa-user" style="color: #2e7d32; margin-right: 5px;"></i>
                                    <span style="color: #2e7d32; font-weight: bold;">Información del Proveedor en el Proyecto</span>
                                </div>
                                <hr style="margin-top: 5px; margin-bottom: 8px; border-color: #b8e0b8;"/>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div style="font-size: 12px; color: #666;">Monto Asignado:</div>
                                        <field name="proveedor_monto_asignado" widget="monetary" nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <div style="font-size: 12px; color: #666;">Monto Utilizado:</div>
                                        <field name="proveedor_monto_utilizado" widget="monetary" nolabel="1" readonly="1"/>
                                    </div>
                                    <div class="col-md-4">
                                        <div style="font-size: 12px; color: #666;">Saldo Disponible:</div>
                                        <field name="proveedor_saldo" widget="monetary" nolabel="1" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        
                        
                        <!-- Segunda columna - campos y tarjetas del lado derecho -->
                        <div class="col-md-6">
                            <group>
                                <field name="fecha_orden" attrs="{'readonly': [('state','in',('purchase','done'))]}"/>
                                <!-- Mostrar el campo daf_authorized -->
                                <field name="daf_authorized" readonly="1" invisible="1"/>
                            </group>
                            
                            <!-- Mensaje de autorización DAF si está autorizado -->
                            
                            
                            <!-- Tarjeta que muestra todos los objetos de gasto del proyecto -->
                            <div class="alert" style="background-color: #EBFEFC; border: 1px solid #EBFEFC; border-radius: 4px; padding: 8px; margin-top: 10px; margin-bottom: 10px; width: 100%;" attrs="{'invisible': [('proyect_id', '=', False)]}">
                                <div style="display: flex; align-items: center; margin-bottom: 5px;">
                                    <i class="fa fa-list" style="color: #555; margin-right: 5px;"></i>
                                    <span style="color: #555; font-weight: bold;">Objetos de Gasto del Proyecto</span>
                                </div>
                                <hr style="margin-top: 5px; margin-bottom: 8px; border-color: #EBFEFC;"/>
                                <field name="objetos_gasto_proyecto_ids" widget="many2many_tags" readonly="1" options="{'no_create': True}" attrs="{'invisible': [('proyect_id', '=', False)]}"/>
                                <field name="objetos_gasto_display" readonly="1" attrs="{'invisible': [('proyect_id', '=', False)]}"/>
                            </div>
                            
                            
                        </div>
                    </div>
                </xpath>
                
                <!-- Ocultar la fecha planned en las líneas de pedido (vista tree) -->
                <xpath expr="//field[@name='order_line']/tree//field[@name='date_planned']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <!-- Ocultar la fecha planned en las líneas de pedido (vista form) -->
                <xpath expr="//field[@name='order_line']/form//field[@name='date_planned']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>