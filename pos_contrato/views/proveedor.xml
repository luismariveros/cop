<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_project_form_inherit_proveedores_extra" model="ir.ui.view">
      <field name="name">project.project.form.inherit.proveedores.extra</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="proyecto_update.view_project_form_inherit_proveedores"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook/page[3]" position="replace">
          <page string="Proveedores">
            <group>
              <group>
                <field name="monto_disponible" readonly="1"/>
              </group>
            </group>
            <field name="proveedor_ids" context="{'default_project_id': id}">
              <list editable="bottom">
                <field name="partner_id"/>
                <field name="monto_contrato"/>
                <field name="monto_pagado"/>
                <field name="pendiente_de_pago" readonly="1"/>
                <field name="nombre_archivo_adjunto" invisible="1"/>
                <field name="archivo_adjunto" filename="nombre_archivo_adjunto" widget="binary"/>
                <button name="action_view_productos" type="object" icon="fa-search" string="Ver Productos"/>
              </list>
              <form>
                <sheet>
                  <notebook>
                    <page string="Productos">
                      <field name="producto_ids">
                        <list editable="bottom">
                          <field name="product_id"/>
                          <field name="importe"/>
                          <field name="objeto_gasto_id"/>
                          <field name="descripcion"/>
                        </list>
                      </field>
                    </page>
                  </notebook>
                </sheet>
              </form>
            </field>
          </page>
           </xpath>
            <xpath expr="//notebook/page[4]" position="replace">
                  <!-- Nueva pestaña de Objetos de Gastos -->
                  <page string="Objetos de Gastos">
                    <field name="objeto_gasto_ids" context="{'default_project_id': id}">
                      <list editable="bottom">
                        <field name="objeto_gasto_id"/>
                        <field name="importe"/>
                        <field name="descripcion"/>
                      </list>
                    </field>
                  </page>
            </xpath>
           <xpath expr="//notebook/page[6]" position="replace">
               <page string="Transferencias" >
                      <field name="pagos_ids" nolabel="1" context="{'default_project_id': id}">
                          <list editable="bottom"><!--
                              <field name="project_id"/>
                              <field name="resolucion_snd"/> -->
                              <field name="str_resolucion_snd"/>
                              <field name="fecha_str"/>
                              <field name="fecha_vencimiento_str"/>
                              <field name="monto_obligado"/>
                          </list>
                      </field>
              </page>
               <page string="Asignación Financiera">
                    <field name="asignacion_ids" nolabel="1" context="{'default_proyecto_id': id}">
                        <list editable="bottom">
                            <field name="mes"/>
                            <field name="monto_asignado"/>
                            <field name="monto_obligado" readonly="1"/>
                            <field name="monto_pagado" readonly="1"/>
                        </list>
                    </field>
                </page>

           </xpath>
      </field>
    </record>
  </data>
</odoo>
