<odoo>
  <data>
    <record id="view_project_form_inherit_state" model="ir.ui.view">
      <field name="name">project.project.form.state</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="project.edit_project"/>
      <field name="arch" type="xml">
        
        <xpath expr="//form/header" position="inside">
          <!-- Botón personalizado -->
          <button name="action_set_execution" type="object"
                  string="Pasar a En Ejecución"
                  invisible="state_project != 'draft'"/>
          
          <!-- Statusbar alineado con los botones -->
          <field name="state_project"
                 widget="statusbar"
                 statusbar_visible="draft,in_progress,execution,done,rendido"
                 readonly="1"/>
        </xpath>

      </field>
    </record>
  </data>
</odoo>
