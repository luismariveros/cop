<odoo>
    <data>
        <record id="view_move_form_inherit_pagos" model="ir.ui.view">
            <field name="name">account.move.inherit.pagos</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='to_check']" position="after">
                    <field name="pagos_ids" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
